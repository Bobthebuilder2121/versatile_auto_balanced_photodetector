TEXT 32 48 Left 2 ;Balanced TIA - basic test
TEXT 32 80 Left 2 ;Nominal diode bias: +150 V / -150 V. Upper bias is trimmed by PI.
TEXT 32 112 Left 2 ;B1: fictive bias sensitivity = 100 uA/V, +20 uA mismatch at 10 ms.
TEXT 240 896 Left 2 ;Buffer
TEXT 656 896 Left 2 ;Active LPF: fc = 1.001 kHz
TEXT 1328 864 Left 2 ;Inverting PI: Kp = 1, fz = 199.69 Hz
TEXT 1808 688 Left 2 ;Post-regulator: BSP89 source follower
TEXT 1104 1280 Left 2 ;Inverted gate command is required for negative feedback.
TEXT 32 1376 Left 2 !.meas tran VBUF_pp PP V(VBUF) FROM=5m TO=10m
TEXT 32 1408 Left 2 !.meas tran VLP_pp PP V(VLP) FROM=5m TO=10m
TEXT 32 1440 Left 2 !.meas tran VPI_pp PP V(VPI) FROM=5m TO=10m
TEXT 32 1472 Left 2 !.meas tran IIN_pp PP I(V1) FROM=5m TO=10m
TEXT 32 1536 Left 2 !.meas tran VOUT_dc_before AVG V(VOUT) FROM=8m TO=10m
TEXT 32 1568 Left 2 !.meas tran VOUT_dc_after AVG V(VOUT) FROM=25m TO=30m
TEXT 32 1600 Left 2 !.meas tran VBIAS_before AVG V(BIAS_P) FROM=8m TO=10m
TEXT 32 1632 Left 2 !.meas tran VBIAS_after AVG V(BIAS_P) FROM=25m TO=30m
TEXT 32 1664 Left 2 !.meas tran IIN_dc_after AVG I(V1) FROM=25m TO=30m
TEXT 32 1696 Left 2 !.meas tran VOUT_pp_after PP V(VOUT) FROM=25m TO=30m
TEXT 32 1728 Left 2 !.func IUP(v,t) {1m+50u*sin(2*pi*100k*t)+20u*if(t>10m,1,0)+100u*(v-150)}
TEXT 1104 1472 Left 2 !.meas tran VPI_min MIN V(VPI)
TEXT 1104 1504 Left 2 !.meas tran VPI_max MAX V(VPI)
TEXT 1104 1536 Left 2 !.meas tran VPI_before AVG V(VPI) FROM=8m TO=10m
TEXT 1104 1568 Left 2 !.meas tran VPI_after AVG V(VPI) FROM=25m TO=30m
TEXT 1104 1600 Left 2 !.meas tran VBN_after AVG V(BIAS_N) FROM=25m TO=30m
TEXT 1808 720 Left 2 ;Gate command = 150 V - VCMD (ideal HV interface)
TEXT 1456 2184 Left 2 ;S1 reference selection: SA=PI, SB=Vref0=0 V
TEXT 864 2216 Left 2 ;S2 PI reset: SA=PI output, D=PI sum, SB unused
TEXT 864 2248 Left 2 ;Switch supplies +/-15 V, control levels 0 / 3.3 V
TEXT 96 2320 Left 2 ;TMUX6136PWR: IBIS + datasheet approximation (+/-15 V, 25 C)
TEXT 96 2368 Left 2 !.temp 25
TEXT 32 1504 Left 2 !.param AB_DELAY=400u
TEXT 96 2464 Left 2 ;Lorlin CK1031: ideal decoded stable positions; coil drivers ideal.
TEXT 96 2496 Left 2 ;0=I+  1=I-  2=balanced  3=autobalanced
TEXT 1808 1360 Left 2 ;Mode 3: PI enabled after 400 us; modes 0-2: fixed reference + PI reset.
TEXT 32 1344 Left 2 !.param MODE_START=2 MODE_END=3 T_SWITCH=15m
TEXT 96 2816 Left 2 !.model Dideal D(Is=1p Rs=0 Cjo=0)
TEXT 96 2856 Left 2 !.tran 0 30m 0 100n
TEXT 96 2896 Left 2 !.options plotwinsize=0
TEXT 96 2936 Left 2 !.meas tran VOUT_pp PP V(VOUT) FROM=50u TO=100u
TEXT 96 2976 Left 2 !.meas tran VOUT_dc AVG V(VOUT) FROM=50u TO=100u
TEXT 96 2408 Left 2 ;Switch contacts depict mode 3; actual state follows mode control.
TEXT 96 352 Left 2 ;B1 / I2: photocurrent
TEXT 96 384 Left 2 ;CJ1 / CJ2: test capacitance
TEXT 96 464 Left 2 ;Relays: Coto 9012-12-10 (approx.)
TEXT 96 496 Left 2 ;No bounce / coil inductance model
TEXT 864 1648 Left 2 ;U3A/U3B: two channels of TMUX6136PWR; datasheet-based analog approximation
TEXT 96 3040 Left 2 !.meas tran VCMD_after AVG V(VCMD) FROM=25m TO=30m
