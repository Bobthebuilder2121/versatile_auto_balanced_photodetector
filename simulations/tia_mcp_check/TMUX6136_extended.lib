* TMUX6136PWR channel: IBIS input + datasheet-based ANALOG APPROXIMATION.
* NOT an official TI SPICE model. Intended for +/-15 V, 25 C, low-voltage controls.
* Generated by tools/build_tmux6136_model.py; original IBIS remains unchanged.
* IBIS SHA256: b1fa1a160b913005c997e15f1dbd83a5f4a38eb81cfde266bf79c77acc6b5a32
* Datasheet: https://www.ti.com/lit/ds/symlink/tmux6136.pdf Rev B, sections 5.5/5.6.
* Each 7-terminal instance is ONE channel, not a physical 7-pin IC.
* Two instances represent the two channels of one TSSOP-16 package.
* SEL=0 connects SB; SEL=1 connects SA. Undefined logic region modeled at 1.4 V.
* No analog-pin clamps, power-off behavior, noise, RF crosstalk or PSRR validation.
* CSOFF to ground plus CD=CON-CSOFF gives lumped selected-node CON at low frequency.
* Capacitance partition, leakage polarity and QJ opposite-edge sign are assumptions.
* QJ=-0.4p is calibrated at VS=0 V; voltage dependence is NOT modeled.
* R_OFF is numerical isolation, NOT inferred from datasheet leakage.
* T_ON/T_OFF reproduce ~66 ns loaded transition / ~40 ns BBM in the test fixture.
.subckt TMUX6136_SPDT SEL SA D SB VSS GND VDD
+ params: RON=120 CSOFF=2.4p CON=5.5p CIN=1.5p
+ IOFF=5p ION=8p R_OFF=1e16 RPD=6Meg
+ T_ON=58n T_OFF=18n QJ=-0.4p VTH=1.4
+ RPKG=0.05
+ LPKG=1e-09
+ CPKG=2e-13
+ CCOMP=3.31e-13
*
* IBIS input: actual external rails, all 99 original current samples.
RSEL SEL SEL_MID {RPKG}
LSEL SEL_MID SEL_DIE {LPKG}
CPIN SEL GND {CPKG}
CDIE SEL_DIE GND {CCOMP}
* Add only the capacitance missing from the 1.5 pF datasheet total.
CEXTRA SEL_DIE GND {max(0,CIN-CPKG-CCOMP)}
RSEL_PD SEL_DIE GND {RPD}
BGND SEL_DIE VSS I=table(V(SEL_DIE,VSS), -30, -0.408025, -29.64, -0.402324, -29.55, -0.400899, -29.46, -0.399473, -29.37, -0.398048, -26.13, -0.346757, -23.88, -0.311177, -23.79, -0.309756, -23.34, -0.302658, -22.89, -0.295586, -22.8, -0.294181, -22.62, -0.291401, -22.53, -0.290062, -22.44, -0.288814, -18.75, -0.239506, -18.66, -0.238304, -16.41, -0.208248, -16.32, -0.207046, -15.87, -0.201035, -15.6, -0.197429, -15.51, -0.196227, -15.33, -0.193823, -15.24, -0.192621, -15.06, -0.190218, -14.97, -0.189016, -10.92, -0.13495, -10.74, -0.132548, -7.41, -0.0881421, -6.15, -0.0713609, -5.25, -0.0593865, -5.16, -0.0581898, -4.89, -0.0546007, -4.35, -0.0474274, -3.63, -0.0378768, -3.54, -0.0366844, -3.45, -0.0354924, -3.36, -0.0343008, -2.91, -0.0283502, -2.82, -0.0271618, -2.46, -0.022416, -2.37, -0.0212319, -2.28, -0.0200489, -2.19, -0.0188672, -2.01, -0.0165082, -1.92, -0.0153314, -1.83, -0.0141568, -1.65, -0.0118154, -1.56, -0.0106498, -1.47, -0.00948849, -1.38, -0.00833259, -1.29, -0.00718364, -1.2, -0.0060439, -1.11, -0.0049169, -1.02, -0.00380867, -0.93, -0.00273052, -0.84, -0.00170718, -0.75, -0.00080455, -0.66, -0.000197401, -0.57, -1.66879e-05, -0.48, -3.00746e-06, -0.39, -2.46533e-06, -0.3, -2.43599e-06, -0.21, -2.42473e-06, -0.12, -2.4134e-06, -0.03, -2.40151e-06, 0.06, -2.38917e-06, 0.15, -2.37649e-06, 1.41, -2.18321e-06, 2.67, -1.98023e-06, 3.93, -1.7744e-06, 5.19, -1.56725e-06, 6.45, -1.35937e-06, 7.71, -1.15102e-06, 8.97, -9.42352e-07, 10.23, -7.33448e-07, 11.49, -5.24362e-07, 12.75, -3.15132e-07, 14.01, -1.06254e-07, 15.27, 0, 16.53, 0, 17.79, 0, 19.05, 0, 20.31, 0, 21.57, 0, 22.83, 0, 24.09, 0, 25.35, 0, 26.61, 0, 27.87, 0, 29.13, 0, 30.39, 0, 31.65, 0, 32.91, 0, 34.17, 0, 35.43, 0, 36.69, 0, 37.5, 0, 37.59, 0, 60, 0)
BPWR SEL_DIE VDD I=table(V(VDD,SEL_DIE), -30, 0.151382, -29.37, 0.144012, -29.28, 0.142959, -29.19, 0.141906, -29.1, 0.140854, -29.01, 0.139801, -25.77, 0.101951, -23.52, 0.0758293, -23.43, 0.0747933, -22.62, 0.0656079, -22.53, 0.0646325, -22.44, 0.0636927, -22.35, 0.0628346, -22.26, 0.0622048, -22.17, 0.061867, -18.48, 0.0504723, -18.21, 0.0496392, -18.12, 0.0493615, -16.14, 0.0432562, -16.05, 0.0429789, -15.69, 0.0418698, -15.42, 0.0410382, -15.33, 0.0407611, -14.43, 0.0379917, -12.54, 0.0321932, -12.45, 0.0319179, -11.55, 0.0291775, -8.49, 0.0208451, -7.41, 0.0179195, -6.15, 0.0145087, -5.25, 0.0120747, -4.89, 0.0111019, -3.63, 0.00770215, -3.54, 0.00745972, -3.45, 0.00721737, -3.36, 0.0069751, -2.91, 0.00576517, -2.82, 0.00552351, -2.46, 0.00455839, -2.37, 0.00431755, -2.28, 0.00407694, -2.19, 0.00383657, -2.01, 0.00335668, -1.92, 0.00311725, -1.83, 0.00287824, -1.65, 0.00240173, -1.56, 0.00216445, -1.47, 0.00192799, -1.38, 0.00169257, -1.29, 0.00145849, -1.2, 0.00122616, -1.11, 0.000996277, -1.02, 0.000769977, -0.93, 0.000549408, -0.84, 0.00033926, -0.75, 0.000152355, -0.66, 2.98756e-05, -0.57, 3.8389e-06, -0.48, 2.55168e-06, -0.39, 2.49573e-06, -0.3, 2.48067e-06, -0.21, 2.46669e-06, -0.12, 2.45257e-06, -0.03, 2.43832e-06, 0.06, 2.42396e-06, 0.15, 2.40952e-06, 1.41, 2.20357e-06, 2.67, 1.99521e-06, 3.93, 1.78613e-06, 5.19, 1.57669e-06, 6.45, 1.36705e-06, 7.71, 1.15726e-06, 8.97, 9.47378e-07, 10.23, 7.37782e-07, 11.49, 5.28022e-07, 12.75, 3.1799e-07, 14.01, 1.08339e-07, 15.09, 0, 15.27, 0, 16.53, 0, 17.79, 0, 19.05, 0, 20.31, 0, 21.57, 0, 22.83, 0, 24.09, 0, 25.35, 0, 26.61, 0, 27.87, 0, 29.13, 0, 30.39, 0, 31.65, 0, 32.91, 0, 34.17, 0, 35.43, 0, 36.69, 0, 37.5, 0, 37.59, 0, 60, 0)
*
* Delayed turn-on / earlier turn-off implements nonoverlapping A/B contacts.
BRAW RAW GND V=if(V(SEL_DIE,GND)>VTH,1,0)
BPOWER POWER_OK GND V=if((V(VDD,GND)>4.9)&(V(GND,VSS)>4.9),1,0)
BA A_EN GND V=V(POWER_OK,GND)*min(delay(V(RAW,GND),T_ON),delay(V(RAW,GND),T_OFF))
BB B_EN GND V=V(POWER_OK,GND)*min(1-delay(V(RAW,GND),T_ON),1-delay(V(RAW,GND),T_OFF))
.model CONTACT SW(Ron=1m Roff={R_OFF} Vt=0.5 Vh=0)
RA SA A_PATH {RON-1m}
RB SB B_PATH {RON-1m}
SA_CONTACT A_PATH D A_EN GND CONTACT
SB_CONTACT B_PATH D B_EN GND CONTACT
CSA SA GND {CSOFF}
CSB SB GND {CSOFF}
CDRAIN D GND {max(0,CON-CSOFF)}
* Offset leakage currents are explicit signed sensitivity parameters.
BLA SA GND I=IOFF*(1-V(A_EN,GND))
BLB SB GND I=IOFF*(1-V(B_EN,GND))
BLD D GND I=ION*(V(A_EN,GND)+V(B_EN,GND))
*
* Smooth charge packet; delivered drain charge = QJ * change(A_EN).
BINJ INJ_RAW GND V=V(A_EN,GND)
RINJ INJ_RAW INJ_FILTER 1k
CINJ INJ_FILTER GND 5p
BQ D GND I=-QJ*ddt(V(INJ_FILTER,GND))
.ends TMUX6136_SPDT
